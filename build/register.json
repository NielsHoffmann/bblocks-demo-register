      "transforms": [
        {
          "id": "to-ttl",
          "type": "python",
          "inputs": {
            "mediaTypes": [
              {
                "mimeType": "application/rdf+xml",
                "label": "RDF/XML",
                "defaultExtension": "rdf"
              }
            ]
          },
          "outputs": {
            "mediaTypes": [
              {
                "mimeType": "text/turtle",
                "defaultExtension": "ttl",
                "label": "RDF/Turtle"
              }
            ]
          },
          "metadata": {
            "dependencies": {
              "pip": "rdflib",
              "python": ">=3.10"
            }
          },
          "code": "import rdflib\ndata = rdflib.Graph()\ndata.parse(data=input_data, format=\"xml\")\noutput_data = data.serialize(format=\"turtle\")"
        }
      ],
