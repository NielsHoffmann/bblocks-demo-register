@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

@base <http://example.com/ns#>.


#################################################################
# Trace object
#################################################################

<#TraceMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./trace.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ];

  rr:subjectMap [
    rr:template "http://trace.example.com/trace/{traceId}";
    rr:class prov:Activity
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "traceId"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:comment;
    rr:objectMap [
      rr:constant "Trace"
    ]
  ].


#################################################################
# Span object
# Individuele acties binnen een trace
#################################################################

<#SpanMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./trace.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ];

  rr:subjectMap [
    rr:template "http://trace.example.com/span/{spanId}";
    rr:class prov:Activity
  ];

  rr:predicateObjectMap [
    rr:predicate prov:startedAtTime;
    rr:objectMap [
      rml:reference "startTimeUnixNano";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:endedAtTime;
    rr:objectMap [
      rml:reference "endTimeUnixNano";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "name";
      rr:datatype xsd:string
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:wasGeneratedBy;
    rr:objectMap [
      rr:template "http://trace.example.com/trace/{traceId}";
      rr:termType rr:IRI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:qualifiedUsage;
    rr:objectMap [
      rr:template "http://trace.example.com/usage/{attributes[2].value.intValue}";
      rr:termType rr:IRI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:qualifiedAssociation;
    rr:objectMap [
      rr:template "http://trace.example.com/association/{attributes[1].value.stringValue}";
      rr:termType rr:IRI
    ]
  ].


#################################################################
# Definitie object
# attributes[3] = dpl.objects.data_object_def
#################################################################

<#DefinitionMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./trace.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ];

  rr:subjectMap [
    rr:template "http://trace.example.com/entity/{attributes[3].value.stringValue}";
    rr:class prov:Entity
  ];

  rr:predicateObjectMap [
    rr:predicate dct:source;
    rr:objectMap [
      rml:reference "attributes[3].value.stringValue";
      rr:termType rr:IRI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rr:constant "definitie van het object"
    ]
  ].


#################################################################
# Relatie tussen activiteit en object
# attributes[2] = dpl.objects.data_object_id
#################################################################

<#ObjectUsageMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./trace.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ];

  rr:subjectMap [
    rr:template "http://trace.example.com/usage/{attributes[2].value.intValue}";
    rr:class prov:Usage
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "attributes[2].value.intValue"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:comment;
    rr:objectMap [
      rr:constant "de qualified usage relatie naar het object"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:entity;
    rr:objectMap [
      rr:template "http://trace.example.com/entity/{attributes[3].value.stringValue}";
      rr:termType rr:IRI
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:qualifiedAssociation;
    rr:objectMap [
      rr:template "http://trace.example.com/association/{attributes[4].value.stringValue}";
      rr:termType rr:IRI
    ]
  ].


#################################################################
# Register verwerkingsactiviteit
# attributes[1] = dpl.core.processing_activity_id
#################################################################

<#AgentMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./trace.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ];

  rr:subjectMap [
    rr:template "http://trace.example.com/agent/{attributes[1].value.stringValue}";
    rr:class prov:Agent
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:comment;
    rr:objectMap [
      rr:constant "de verwerkingsactiviteit"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
      rml:reference "attributes[1].value.stringValue"
    ]
  ].


#################################################################
# Relatie tussen activiteit en verwerkingsregister
# attributes[1] = dpl.core.processing_activity_id
#################################################################

<#AgentAssociationMapping> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./trace.json";
    rml:referenceFormulation ql:JSONPath;
    rml:iterator "$.resourceSpans[*].scopeSpans[*].spans[*]"
  ];

  rr:subjectMap [
    rr:template "http://trace.example.com/association/{attributes[1].value.stringValue}";
    rr:class prov:Association
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:comment;
    rr:objectMap [
      rr:constant "de qualified association relatie naar het register"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate prov:agent;
    rr:objectMap [
      rr:template "http://trace.example.com/agent/{attributes[1].value.stringValue}";
      rr:termType rr:IRI
    ]
  ].


